# AdScout configuration — copy this file to `.env` and fill in your values.
# The `.env` file is gitignored: secrets never end up in git.

# ── Meta Ad Library API ──────────────────────────────────────────────
# Long-lived user access token from your Meta developer app.
# How to get one: see README section "Meta developer-app en token".
# Tokens expire after ±60 days; `adscout status` shows token health.
META_ACCESS_TOKEN=

# Graph API version. One place to bump when Meta deprecates a version.
# See README section "Graph API-versie ophogen".
META_GRAPH_VERSION=v23.0

# ── AdScout ──────────────────────────────────────────────────────────
# Where the SQLite database and downloaded creatives live.
# Back up = copy this directory. Defaults are fine.
ADSCOUT_DATA_DIR=data

# Default countries for new advertisers (comma-separated ISO codes).
ADSCOUT_DEFAULT_COUNTRIES=NL

# ── Optional: AI tag suggestions (Fase 3) ────────────────────────────
# Leave empty to disable. AdScout works fully without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Optional: future notifications (Notifier interface, not built yet) ─
# NOTIFY_CHANNEL=

# ── Compass: Shopify (read-only custom app) ──────────────────────────
# The shop's own myshopify.com domain plus the Admin API access token
# (shpat_…) of the "Compass" custom app.
# How to set up: compass/README.md, section "Shopify custom app aanmaken".
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=

# Shopify Admin API version. One place to bump, and only when Shopify
# deprecates the pinned version — see compass/README.md, "Onderhoud".
SHOPIFY_API_VERSION=2025-04

# ── Compass: Meta Marketing API ──────────────────────────────────────
# Our own ad account id (act_…, with or without the act_ prefix; found in
# the Ads Manager URL). The token is the existing META_ACCESS_TOKEN above,
# extended with the ads_read permission — see compass/README.md, section
# "Meta Marketing API koppelen".
META_AD_ACCOUNT_ID=

# ── Compass: bol Retailer API ────────────────────────────────────────
# Client credentials from the bol partner platform.
# How to get them: compass/README.md, section "bol Retailer API koppelen".
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# ── Compass: storage ─────────────────────────────────────────────────
# Where the Compass SQLite databases live. Sharing data/ with AdScout is
# fine (separate database files). Back up = copy this directory.
COMPASS_DATA_DIR=data
