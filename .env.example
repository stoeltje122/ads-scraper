# AdScout configuration — copy this file to `.env` and fill in your values.
# The `.env` file is gitignored: secrets never end up in git.

# ── Meta Ad Library API ──────────────────────────────────────────────
# Long-lived user access token from your Meta developer app.
# How to get one: see README section "Meta developer-app en token".
# Tokens expire after ±60 days; `adscout status` shows token health.
META_ACCESS_TOKEN=

# Graph API version. One place to bump when Meta deprecates a version.
# See README section "Graph API-versie ophogen".
META_GRAPH_VERSION=v23.0

# ── AdScout ──────────────────────────────────────────────────────────
# Where the SQLite database and downloaded creatives live.
# Back up = copy this directory. Defaults are fine.
ADSCOUT_DATA_DIR=data

# Default countries for new advertisers (comma-separated ISO codes).
ADSCOUT_DEFAULT_COUNTRIES=NL

# ── Shared: Claude API (AdScout tag suggestions + Pulse analysis) ────
# One key for both tools. Leave empty to disable AI features; everything
# else keeps working. How to get one: PULSE.md section "AI-analyse aanzetten".
ANTHROPIC_API_KEY=
# Model for AdScout's ad-tag suggestions.
ANTHROPIC_MODEL=claude-sonnet-5

# ═════════════════════════ Pulse ═════════════════════════════════════
# Pulse (PULSE.md) shares this .env with AdScout. All Pulse-specific
# variables are prefixed PULSE_.

# Where Pulse's SQLite database and the Gmail credentials/token live.
# Back up = copy this directory. Defaults are fine.
PULSE_DATA_DIR=data

# The support mailbox Pulse reads (readonly, via the Gmail API).
PULSE_MAILBOX=info@cloudplunge.com

# How many days the FIRST Gmail collect looks back. After that Pulse
# continues from the last successful run.
PULSE_MAIL_BACKFILL_DAYS=90

# ── Meta Page-token (comments on own posts/ads) ──────────────────────
# Page access token + page id of the Cloudplunge Facebook page.
# How to get them: PULSE.md section "Facebook/Instagram-reacties koppelen".
META_PAGE_TOKEN=
PULSE_META_PAGE_ID=

# Model for Pulse's feedback analysis (cost-efficient default).
PULSE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Optional: future notifications (Notifier interface, not built yet) ─
# NOTIFY_CHANNEL=
